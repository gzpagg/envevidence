{
  "version": 2,
  "name": "Env studio · Glacier",
  "colors": {
    "paper": "#F5F8FC",
    "surface": "#FFFFFF",
    "ink": "#142C43",
    "muted": "#536A7F",
    "accent": "#176BDA",
    "line": "#D6E2EE",
    "control_border": "#7B8FA5",
    "success": "#316247",
    "warning": "#8D621D",
    "error": "#A03232"
  },
  "fonts": {
    "body": "Source Sans 3",
    "heading": "Source Sans 3"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "control": 12,
    "card": 20,
    "dialog": 24,
    "navigation": 28
  },
  "type": {
    "body": 16,
    "caption": 12,
    "line_height": 1.5,
    "heading_mobile": 28,
    "heading_desktop": 30
  },
  "interaction": {
    "touch_min": 48,
    "transition_ms": 200,
    "reduced_motion": true
  },
  "materials": {
    "glass": {
      "fill": "rgba(255,255,255,0.75)",
      "opacity": 0.75,
      "blur_px": 16,
      "saturation": 1.15,
      "border": "rgba(255,255,255,0.8)"
    },
    "solid": {
      "fill": "#FFFFFF"
    }
  },
  "gradients": {
    "focus": {
      "from": "#E8F3FF",
      "to": "#E4F6F2",
      "angle": 135
    }
  },
  "elevation": {
    "card": "0 4px 18px rgba(38,70,100,0.05)",
    "floating": "0 8px 32px rgba(38,70,100,0.12)"
  }
}
