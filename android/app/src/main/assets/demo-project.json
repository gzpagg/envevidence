  "studies": [
    {
      "id": "bf589be5f47d4aa88c661bea2763df82",
      "name": "Synthetic water-treatment study",
      "documents": [
        {
          "id": "bf3ad05742ff57622b03",
          "filename": "synthetic_main.pdf",
          "sha256": "bf3ad05742ff57622b038114aa5af16e2c6c726ed8f6c8dfc643274b0f4761b3",
          "role": "main",
          "page_count": 3,
          "blocks": [
            {
              "id": "bf3ad05742ff57622b03:p1",
              "page": 1,
              "text": "EnvEvidence | Synthetic research fixture\nNOT A REAL PUBLICATION. Invented values for software testing only.\nThis original example is distributed under the repository MIT license.\nStudy: water treatment using three distinct experimental conditions.\nReported removal refers to the target pollutant. TOC removal is a separate endpoint.\nReagent doses for Trials A and B are reported in the accompanying supplement.\nDo not use these invented values for research conclusions or method recommendations.\nSynthetic fixture | PDF page 1\n"
            },
            {
              "id": "bf3ad05742ff57622b03:p2",
              "page": 2,
              "text": "Results | Trials A and B\nTrial A: acetaminophen in synthetic water, initial concentration 10 mg/L.\nTrial A used UV/H2O2 at pH 7.0 for 30 min.\nTrial A: acetaminophen removal was 85%; TOC removal was 20%.\nTrial B: acetaminophen in synthetic water, initial concentration 10 mg/L.\nTrial B used H2O2 in the dark at pH 7.0 for 30 min.\nTrial B: acetaminophen removal was 12%; TOC removal was 2%.\nThese results belong to separate treatment arms and must not be merged.\nSynthetic fixture | PDF page 2\n"
            },
            {
              "id": "bf3ad05742ff57622b03:p3",
              "page": 3,
              "text": "Results | Trial C\nTrial C: sulfamethoxazole in real wastewater, initial concentration 5 mg/L.\nTrial C used UV/H2O2 at pH 6.5 for 60 min.\nTrial C: H2O2 dose was 15 mg/L.\nTrial C: sulfamethoxazole removal was 64%.\nThe fixture provides no TOC endpoint for Trial C.\nSynthetic fixture | PDF page 3\n"
            }
          ],
          "warnings": [],
          "parser": "pypdf"
        },
        {
          "id": "a67be887c1212fd0bea7",
          "filename": "synthetic_supplement.pdf",
          "sha256": "a67be887c1212fd0bea7fba05ccbb3f98699bd9aae2328f51c31ebfeea571c33",
          "role": "supplement",
          "page_count": 1,
          "blocks": [
